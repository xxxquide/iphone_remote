# Copy to .env at the repo root (1-setup.command does this for you).
# All values are optional — defaults live in core/core/config.py.
# NOTE: comments are kept on their own lines. The loader also strips inline
# ` # comments`, but own-line comments are the safest style.

# --- server ---
# Use 0.0.0.0 only when the phone must reach /media over the LAN.
ORCH_HOST=127.0.0.1
ORCH_PORT=8787
ORCH_TOKEN=dev-local-token

# --- mode ---
# true  = mock devices, no phones needed (great for UI work)
# false = drive real devices via the Device Bridge (see 4-real-mode.command)
ORCH_MOCK=true

# --- tunnel backend: pymobiledevice3 | go-ios ---
# go-ios's userspace tunnel is broken on iOS 26.4-26.5 (issue #772).
ORCH_TUNNEL=pymobiledevice3

# --- signing (free Apple ID) ---
# Re-sign WDA this many days before the 7-day certificate expires.
ORCH_APPLE_ID=
ORCH_WDA_RESIGN_DAYS=6

# --- media handoff to the phone (put_media step) ---
# The phone's "OrchSaveToPhotos" Shortcut fetches the video from the Mac.
# ORCH_LAN_HOST is auto-detected when empty.
ORCH_LAN_HOST=
ORCH_MEDIA_TOKEN=change-me-media-token

# --- health/recovery loop ---
ORCH_HEALTH_INTERVAL_S=10

# --- vision-LLM targeting (cascade level 4; off by default) ---
# Set ORCH_LLM_API_KEY to enable. Never commit real keys.
ORCH_LLM_ENABLED=false
ORCH_LLM_BASE_URL=https://api.openai.com/v1
ORCH_LLM_MODEL=gpt-4o-mini
ORCH_LLM_API_KEY=
ORCH_LLM_MAX_PER_MIN=20
