# Copy to .env at the repo root. All optional — sane defaults in core/core/config.py.

# --- server ---
ORCH_HOST=127.0.0.1          # use 0.0.0.0 ONLY when the phone must reach /media over LAN
ORCH_PORT=8787
ORCH_TOKEN=dev-local-token

# --- mode ---
# true  = mock devices, no phones needed (default; great for UI work)
# false = drive real devices via the Device Bridge
ORCH_MOCK=true

# --- tunnel backend: pymobiledevice3 | go-ios ---
ORCH_TUNNEL=pymobiledevice3

# --- signing (free Apple ID) ---
ORCH_APPLE_ID=your.secondary@icloud.com
ORCH_WDA_RESIGN_DAYS=6        # re-sign WDA this many days before the 7-day cert expires

# --- media handoff to the phone (put_media step) ---
# The phone's "OrchSaveToPhotos" Shortcut fetches the video from the Mac over LAN.
ORCH_LAN_HOST=                # Mac LAN IP the phone can reach; auto-detected if empty
ORCH_MEDIA_TOKEN=change-me-media-token   # unguessable path segment for /media

# --- vision-LLM targeting (cascade level 4; off by default) ---
ORCH_LLM_ENABLED=false
ORCH_LLM_BASE_URL=https://api.openai.com/v1
ORCH_LLM_MODEL=gpt-4o-mini
ORCH_LLM_API_KEY=            # set to enable; never commit real keys
ORCH_LLM_MAX_PER_MIN=20      # rate limit (calls/minute)
